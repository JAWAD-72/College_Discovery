# Database — Supabase or Neon PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/college_discovery"

# Direct connection URL (for migrations, bypasses connection pooler)
DIRECT_URL="postgresql://postgres:password@localhost:5432/college_discovery"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
